{
  "name": "vueuc",
  "version": "0.4.65",
  "packageManager": "pnpm@10.23.0",
  "description": "Util Components for Vue",
  "author": "07akioni",
  "license": "MIT",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "es/index.js",
  "files": [
    "es",
    "lib"
  ],
  "scripts": {
    "start": "vite",
    "build:site": "vite build",
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "clean": "rm -rf lib es site",
    "release": "pnpm run clean && pnpm run build && pnpm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --config oxlintrc.json --type-aware",
    "lint:fix": "oxlint --config oxlintrc.json --type-aware --fix"
  },
  "peerDependencies": {
    "vue": "^^3.0.11"
  },
  "dependencies": {
    "@css-render/vue3-ssr": "^0.15.14",
    "@juggle/resize-observer": "^3.4.0",
    "css-render": "^0.15.14",
    "evtd": "^0.2.4",
    "seemly": "^0.3.10",
    "vdirs": "^0.1.8",
    "vooks": "^0.2.12"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "oxlint": "^1.32.0",
    "oxlint-tsgolint": "^0.8.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
